---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TODO from '../components/TODO.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing, billing } from '../data/site';

const open = [
  'What the rate includes besides power',
  'Setup fee and deposit',
  'Minimum term and minimum fleet size',
  'Payment currencies and methods',
];
---
<Base title="Pricing" description={`Mining hosting at ${pricing.rateLabel} per kWh, billed on the days your machines run. Request a quote for your fleet.`}>
  <PageHead eyebrow="Pricing" title="One rate per kWh" lead="You pay for the power your machines use, on the days they run. Send us your fleet details for a full quote." />

  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-[1fr_1.4fr]">
      <div class="panel flex flex-col gap-3 self-start p-6">
        <p class="eyebrow">Hosting rate</p>
        <p class="font-display text-5xl font-bold tracking-tight">
          {pricing.rateLabel}<span class="ml-2 text-lg font-medium text-muted">per kWh</span>
        </p>
        <p class="text-sm text-muted">US dollars, per kilowatt-hour consumed.</p>
        <a href="/contact" class="btn btn-gold mt-2 self-start">Request a quote</a>
      </div>
      <div class="flex flex-col gap-6">
        <div class="panel p-6">
          <h2 class="mb-4 text-xl font-bold">How your charge is calculated</h2>
          <ul class="flex flex-col gap-2.5 text-[0.9375rem]">
            {billing.map((b) => (
              <li class="flex gap-2.5"><span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-accent"></span><span>{b}</span></li>
            ))}
          </ul>
          <a href="/monitoring" class="mt-4 inline-block font-semibold text-accent">See a sample report →</a>
        </div>
        <div class="panel p-6">
          <h2 class="mb-4 text-xl font-bold">Other terms</h2>
          <ul class="flex flex-col gap-3">
            {open.map((item) => (
              <li class="flex flex-col gap-1.5 border-b border-line pb-3 last:border-0 last:pb-0">
                <span class="font-medium">{item}</span>
                <TODO source="content/pricing.md" inline>to be provided</TODO>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
