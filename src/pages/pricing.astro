---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Todo from '../components/Todo.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing } from '../data/site';

const open = [
  'What the rate includes',
  'How power use is measured and billed',
  'Setup fee and deposit',
  'Minimum term and minimum fleet size',
  'Payment currencies and methods',
];
---
<Base title="Pricing" description={`Mining hosting at ${pricing.rateLabel} per kWh. Request a quote for your fleet.`}>
  <PageHead eyebrow="Pricing" title="One rate per kWh" lead="You pay for the power your machines use. Send us your fleet details for a full quote." />

  <section class="section">
    <div class="container-page grid gap-6 md:grid-cols-[1fr_1.4fr]">
      <div class="panel flex flex-col gap-3 p-6">
        <p class="eyebrow">Hosting rate</p>
        <p class="font-display text-5xl font-bold tracking-tight">
          {pricing.rateLabel}<span class="ml-2 text-lg font-medium text-muted">per kWh</span>
        </p>
        <p class="text-sm text-muted">US dollars, per kilowatt-hour consumed.</p>
        <a href="/contact" class="btn btn-gold mt-2 self-start">Request a quote</a>
      </div>
      <div class="panel p-6">
        <h2 class="mb-4 text-xl font-bold">Pricing details</h2>
        <ul class="flex flex-col gap-3">
          {open.map((item) => (
            <li class="flex flex-col gap-1.5 border-b border-line pb-3 last:border-0 last:pb-0">
              <span class="font-medium">{item}</span>
              <Todo source="content/pricing.md" inline>to be provided</Todo>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
