---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TODO from '../components/TODO.astro';
import CtaBand from '../components/CtaBand.astro';

const groups = [
  { id: 'power', title: 'Power' },
  { id: 'cooling', title: 'Cooling' },
  { id: 'operations', title: 'Operations and repair' },
  { id: 'monitoring', title: 'Monitoring' },
];
---
<Base title="Services" description="What Segments Cloud mining hosting includes: power, cooling, operations and repair, and monitoring.">
  <PageHead eyebrow="Services" title="What hosting includes">
    <TODO source="content/services.md">One-paragraph overview of the hosting service</TODO>
  </PageHead>

  <section class="section">
    <div class="container-page grid gap-4 md:grid-cols-2">
      {groups.map((g) => (
        <article id={g.id} class="panel flex scroll-mt-32 flex-col gap-3 p-6">
          <h2 class="text-xl font-bold">{g.title}</h2>
          <TODO source="content/services.md">What is included under {g.title.toLowerCase()}</TODO>
        </article>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>
