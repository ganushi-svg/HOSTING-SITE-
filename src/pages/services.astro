---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TODO from '../components/TODO.astro';
import CtaBand from '../components/CtaBand.astro';
import { services } from '../data/site';

const groups = [
  { id: 'power', title: 'Power', items: services.power },
  { id: 'cooling', title: 'Cooling', items: services.cooling },
  { id: 'operations', title: 'Operations and repair', items: services.operations },
  { id: 'monitoring', title: 'Monitoring', items: services.monitoring },
];
---
<Base title="Services" description="What Segments Cloud mining hosting includes: power, cooling, operations and repair, and monitoring.">
  <PageHead eyebrow="Services" title="What hosting includes">
    <TODO source="content/services.md">One-paragraph overview of the hosting service</TODO>
  </PageHead>

  <section class="section">
    <div class="container-page grid gap-4 md:grid-cols-2">
      {groups.map((g) => (
        <article id={g.id} class="panel flex scroll-mt-32 flex-col gap-3 p-6">
          <h2 class="text-xl font-bold">{g.title}</h2>
          <ul class="flex flex-col gap-2 text-[0.9375rem]">
            {g.items.map((i) => (
              <li class="flex gap-2.5"><span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full bg-accent"></span><span>{i}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-wash">
    <div class="container-page flex flex-col gap-6">
      <div class="flex max-w-[62ch] flex-col gap-2">
        <p class="eyebrow">Machines</p>
        <h2 class="text-[1.75rem] font-bold">Models we host today</h2>
        <p class="text-muted">Ask us about any model not listed here.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="panel flex flex-col gap-3 p-6">
          <h3 class="text-lg font-bold">Air-cooled</h3>
          <ul class="flex flex-wrap gap-2">
            {services.modelsAir.map((m) => <li class="rounded-full border border-line bg-bg px-3 py-1 text-sm">{m}</li>)}
          </ul>
        </div>
        <div class="panel flex flex-col gap-3 p-6">
          <h3 class="text-lg font-bold">Hydro-cooled</h3>
          <ul class="flex flex-wrap gap-2">
            {services.modelsHydro.map((m) => <li class="rounded-full border border-line bg-bg px-3 py-1 text-sm">{m}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
