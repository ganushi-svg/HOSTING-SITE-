---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TODO from '../components/TODO.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { company, sites, photos } from '../data/site';

const gallery = [photos.hallFanWall, photos.hydroPumps, photos.siteExterior, photos.coolingUnit];
---
<Base title="Sites and infrastructure" description={`Segments Cloud runs ${sites.activeCount} hosting sites in the ${company.serviceArea}, with air-cooled halls and a hydro-cooled zone.`}>
  <PageHead
    eyebrow="Sites and infrastructure"
    title={`Our hosting sites in the ${company.serviceArea}`}
    lead={`${sites.activeCount} active sites, each with a site in-charge and on-site hosting technicians.`}
  />

  <section class="section">
    <div class="container-page grid gap-4 md:grid-cols-3">
      <div class="panel flex flex-col gap-2 p-6">
        <p class="eyebrow">Sites</p>
        <p class="font-display text-4xl font-bold">{sites.activeCount}</p>
        <p class="text-sm text-muted">Active hosting sites in the {company.serviceArea}</p>
      </div>
      <div class="panel flex flex-col gap-2 p-6">
        <p class="eyebrow">Cooling</p>
        <ul class="flex flex-col gap-1.5 text-[0.9375rem]">
          {sites.cooling.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="panel flex flex-col gap-2 p-6">
        <p class="eyebrow">Capacity</p>
        <TODO source="content/sites.md">Power capacity per site, if approved for publishing</TODO>
      </div>
    </div>
  </section>

  <section class="section bg-wash">
    <div class="container-page flex flex-col gap-6">
      <div class="flex max-w-[62ch] flex-col gap-2">
        <h2 class="text-[1.75rem] font-bold">From our sites</h2>
        <p class="text-muted">Photos taken by our team during installation.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {gallery.map((p) => <Photo photo={p} crop />)}
      </div>
      <TODO source="assets/photos">Photos of finished halls with machines running, and a site video</TODO>
    </div>
  </section>

  <CtaBand />
</Base>
