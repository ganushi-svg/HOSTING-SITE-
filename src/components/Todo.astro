---
// Visible placeholder for content that has not been provided yet.
interface Props {
  source: string; // the content/ file that will fill this
  inline?: boolean;
}
const { source, inline = false } = Astro.props;
const Tag = inline ? 'span' : 'div';
---
<Tag
  class:list={[
    'rounded-md bg-todo-bg text-todo-ink text-sm',
    inline ? 'inline-block max-w-full px-2 py-0.5' : 'block border border-dashed border-todo-ink/40 px-4 py-3',
  ]}
  data-todo={source}
>
  <strong class="font-mono text-xs tracking-wide">TODO</strong>
  <span class="ml-1"><slot /></span>
  <span class="ml-1 font-mono text-xs opacity-80 break-all">({source})</span>
</Tag>
