---
import { reportMeta, reportRows, RATE } from '../data/sample-report';

const usd = (n: number) => `$${n.toFixed(2)}`;
const num = (n: number, d = 1) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
---
<div class="panel overflow-hidden">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-line bg-wash px-5 py-4">
    <div>
      <p class="font-display text-lg font-bold">{reportMeta.title}</p>
      <p class="text-sm text-muted">Period: {reportMeta.period}</p>
    </div>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm">
      <dt class="text-muted">Hosting rate</dt><dd class="font-mono tabular-nums">${RATE.toFixed(3)} / kWh</dd>
      <dt class="text-muted">Billing hours / day</dt><dd class="font-mono tabular-nums">{reportMeta.billingHours}</dd>
    </dl>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[860px] border-collapse text-left text-sm">
      <thead class="text-xs uppercase tracking-wide text-muted">
        <tr class="border-b border-line">
          <th scope="col" class="px-4 py-3 font-semibold">Machine</th>
          <th scope="col" class="px-4 py-3 font-semibold">Model</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Watts</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Running days</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Downtime days</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Energy kWh</th>
          <th scope="col" class="px-4 py-3 text-right font-semibold">Charge</th>
          <th scope="col" class="px-4 py-3 font-semibold">Basis of running days</th>
          <th scope="col" class="px-4 py-3 font-semibold">Notes</th>
        </tr>
      </thead>
      <tbody class="font-mono tabular-nums">
        {reportRows.map((r) => (
          <tr class="border-b border-line last:border-0">
            <td class="px-4 py-3 font-sans">{r.unit}</td>
            <td class="px-4 py-3 font-sans">{r.model}</td>
            <td class="px-4 py-3 text-right">{r.watts.toLocaleString('en-US')}</td>
            <td class="px-4 py-3 text-right">{num(r.runningDays)}</td>
            <td class="px-4 py-3 text-right">{num(r.downtimeDays)}</td>
            <td class="px-4 py-3 text-right">{num(r.kwh)}</td>
            <td class="px-4 py-3 text-right font-semibold">{usd(r.charge)}</td>
            <td class="px-4 py-3 font-sans text-muted">{r.basis}</td>
            <td class="px-4 py-3 font-sans text-muted">{r.notes}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="border-t border-line bg-wash px-5 py-3 font-mono text-xs text-muted">
    Charge = watts × {reportMeta.billingHours} × running days ÷ 1,000 × rate
  </p>
</div>
