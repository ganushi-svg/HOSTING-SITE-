---
import { nav, company } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-20 border-b border-line bg-bg/95 backdrop-blur" style="top: env(safe-area-inset-top, 0px)">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
      <img src="/logo-mark.webp" width="30" height="35" alt="" />
      <span class="font-display text-[1.05rem] font-bold leading-tight">
        {company.brand}
        <small class="block text-[0.625rem] font-semibold uppercase tracking-[0.14em] text-muted">Mining hosting · {company.serviceArea}</small>
      </span>
    </a>
    <a href="/contact" class="btn btn-gold hidden sm:inline-flex">Request a quote</a>
  </div>
  <nav aria-label="Main" class="container-page">
    <ul class="-mb-px flex gap-1 overflow-x-auto border-t border-line [scrollbar-width:none]">
      {nav.map((item) => {
        const active = item.href === path;
        return (
          <li class="flex-none">
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block border-b-2 px-3 py-2.5 text-sm font-medium no-underline',
                active ? 'border-gold text-navy' : 'border-transparent text-muted hover:text-ink',
              ]}
            >{item.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
