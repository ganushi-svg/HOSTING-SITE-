---
import { company, contact, nav } from '../data/site';
import Todo from './Todo.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-wash">
  <div class="container-page grid gap-8 py-10 text-sm text-muted md:grid-cols-3">
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-ink">
        <img src="/logo-mark.webp" width="22" height="26" alt="" />
        <span class="font-display font-bold">{company.brand}</span>
      </div>
      <p>Mining hosting in the {company.serviceArea}.</p>
      <address class="not-italic">{contact.office}</address>
    </div>
    <div>
      <p class="eyebrow mb-3">Pages</p>
      <ul class="grid grid-cols-2 gap-1.5">
        {nav.map((i) => <li><a class="text-muted hover:text-ink" href={i.href}>{i.label}</a></li>)}
      </ul>
    </div>
    <div class="flex flex-col gap-1.5">
      <p class="eyebrow mb-1.5">Contact</p>
      <span class="select-all text-ink">{contact.email}</span>
      <span class="select-all text-ink">{contact.phone}</span>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-muted">
      <span>© {year} {company.legalNames.join(' · ')}</span>
      <span class="flex flex-wrap gap-2">
        <Todo source="legal" inline>Privacy policy</Todo>
        <Todo source="legal" inline>Terms of use</Todo>
      </span>
    </div>
  </div>
</footer>
