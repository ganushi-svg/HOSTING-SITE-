---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Tell us about your fleet',
  text = 'Share your machine models and quantity, and we will send you a hosting quote.',
} = Astro.props;
---
<section class="bg-gradient-to-br from-band-1 via-band-2 to-band-3 text-band-ink">
  <div class="container-page flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center">
    <div class="flex max-w-[56ch] flex-col gap-2">
      <h2 class="text-2xl font-bold md:text-[1.75rem]">{title}</h2>
      <p class="text-band-muted">{text}</p>
    </div>
    <a href="/contact" class="btn btn-gold flex-none">Request a quote</a>
  </div>
</section>
