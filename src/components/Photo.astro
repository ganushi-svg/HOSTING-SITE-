---
// Real site photo from public/photos, served at two sizes.
interface Props {
  photo: { name: string; w: number; h: number; alt: string; caption: string };
  sizes?: string;
  eager?: boolean;
  crop?: boolean; // force a uniform 4:3 frame, e.g. in galleries
  class?: string;
}
const { photo, sizes = '(min-width: 768px) 50vw, 100vw', eager = false, crop = false, class: className } = Astro.props;
---
<figure class:list={['flex flex-col gap-2', className]}>
  <img
    src={`/photos/${photo.name}-1600.webp`}
    srcset={`/photos/${photo.name}-800.webp 800w, /photos/${photo.name}-1600.webp 1600w`}
    sizes={sizes}
    width={photo.w}
    height={photo.h}
    alt={photo.alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class:list={['h-auto w-full max-w-full rounded-[var(--radius-card)] border border-line object-cover', crop && 'aspect-[4/3]']}
  />
  <figcaption class="text-sm text-muted">{photo.caption}</figcaption>
</figure>
