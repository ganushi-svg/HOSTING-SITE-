---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<section class="border-b border-line bg-wash">
  <div class="container-page flex max-w-6xl flex-col gap-3 py-12 md:py-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="max-w-[22ch] text-[clamp(2rem,4.5vw,2.75rem)] font-bold text-ink">{title}</h1>
    {lead && <p class="max-w-[62ch] text-lg text-muted">{lead}</p>}
    <slot />
  </div>
</section>
