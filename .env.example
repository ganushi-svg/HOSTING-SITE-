# Canonical URLs, sitemap and Open Graph. Use the Vercel preview URL until the real domain is approved.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Enquiry form (server-side only, never prefix with NEXT_PUBLIC_).
RESEND_API_KEY=
# Optional until segments.ae is verified in Resend. Without it, Resend's test sender is used,
# which only delivers to the Resend account owner's address.
RESEND_FROM_EMAIL=Segments Cloud <website@segments.ae>
# Optional. Defaults to the contact email in src/lib/site.ts.
RESEND_TO_EMAIL=ganushi@segments.ae
